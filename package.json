{
  "name": "emprestai",
  "version": "0.1.0",
  "private": true,
  "description": "EmpresTI — empréstimo de equipamentos, Next.js, Supabase e Vercel",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:generate": "prisma generate",
    "db:migrate:local": "tsx scripts/local-migrate.ts",
    "db:deploy:human": "tsx scripts/human-production.ts migrate",
    "db:runtime-password:human": "tsx scripts/human-production.ts runtime-password",
    "db:seed:human": "tsx scripts/human-production.ts seed",
    "images:upload:human": "tsx scripts/human-production.ts images",
    "verify:spec": "node scripts/verify-spec.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/open-sans": "5.3.0",
    "@hookform/resolvers": "5.9.2",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-dialog": "1.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@trpc/server": "11.23.0",
    "@trpc/client": "11.23.0",
    "@trpc/react-query": "11.23.0",
    "@tanstack/react-query": "5.105.3",
    "@prisma/client": "6.12.0",
    "superjson": "2.2.6",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "26.1.0",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "prisma": "6.12.0",
    "tsx": "4.23.15",
    "@playwright/test": "1.64.1",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.4",
    "prettier": "3.9.10",
    "@testcontainers/postgresql": "12.2.1",
    "@testing-library/dom": "10.4.2",
    "jiti": "2.7.0"
  },
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "packageManager": "npm@10.9.9",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "postcss": "8.5.32",
    "deepmerge-ts": "8.0.0"
  }
}
